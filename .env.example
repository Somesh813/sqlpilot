# ==========================================================
# SQLPilot environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ==========================================================

# --- Runtime ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200

# --- Application database (MongoDB) ---
# Stores users, connections, schemas, conversations, history, audit logs.
# Local MongoDB without auth (default for `npm run dev:backend`):
DATABASE_URL=mongodb://localhost:27017/sqlpilot

# Docker Compose (production-shaped). There are NO default passwords: compose refuses to start
# until these are set. Use hex so nothing needs URL-encoding:  openssl rand -hex 24
# MONGO_ROOT_PASSWORD=
# MONGO_APP_PASSWORD=
# For `docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d mongo`, then run the
# API on the host with:
#   DATABASE_URL=mongodb://sqlpilot:<MONGO_APP_PASSWORD>@localhost:27017/sqlpilot?authSource=sqlpilot

# --- Authentication ---
# Use long random strings (e.g. `openssl rand -hex 48`). Must differ from each other.
JWT_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string
# (production start-up rejects these placeholder values)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Credential encryption ---
# 32-byte key, hex-encoded (64 hex chars). `openssl rand -hex 32`
# Used to AES-256-GCM encrypt stored external database credentials.
ENCRYPTION_KEY=replace-with-64-hex-chars

# --- AI provider ---
# AI_PROVIDER selects which section below is used. Both are OpenAI-SDK-compatible,
# so switching is just this flag plus the matching *_API_KEY.
AI_PROVIDER=openai
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_SCHEMA_TABLES=25
# 'json_schema' (default) enforces the exact response shape at the API level.
# Set to 'json_object' if your chosen model/provider doesn't support strict
# schema mode — the response is still validated against the schema either way.
AI_STRUCTURED_OUTPUT_MODE=json_schema

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_BASE_URL=   # optional: point at any other OpenAI-compatible endpoint

# Groq (used when AI_PROVIDER=groq) — https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Query execution safety ---
QUERY_TIMEOUT_MS=15000
QUERY_MAX_ROWS=1000
QUERY_DEFAULT_PAGE_SIZE=100
# Global kill switch. Even ADMIN write policies are ignored unless this is true.
ALLOW_WRITE_QUERIES=false

# --- Where connections may point ---
# SQLite files must live inside one of these directories (comma-separated). Symlinks are resolved first.
SQLITE_ALLOWED_DIRS=./data/sqlite
# Optional allowlist of database hosts: names, *.example.com, IPs or CIDRs (e.g. 10.0.0.0/24).
# When set, ONLY these hosts are allowed. When empty, production refuses loopback / private /
# link-local / cloud-metadata addresses (DB_BLOCK_PRIVATE_HOSTS defaults to true in production).
# DB_ALLOWED_HOSTS=db.internal.example.com,10.20.0.0/16
# DB_BLOCK_PRIVATE_HOSTS=false

# --- Reverse proxy ---
# Number of proxies in front of the API whose X-Forwarded-For entry is trusted. 0 = none.
# The bundled nginx makes this 1. Never "true": that trusts a header the client controls.
TRUST_PROXY_HOPS=0

# --- Email (password reset) ---
# smtp = real delivery | file = development outbox in MAIL_OUTBOX_DIR (refused in production) |
# none = nothing is sent (production default until SMTP is set up).
MAIL_TRANSPORT=file
# MAIL_SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=SQLPilot <no-reply@localhost>
# MAIL_OUTBOX_DIR=./data/outbox
# Public URL of the web app (used in emailed links). Defaults to the first CORS_ORIGIN.
# APP_BASE_URL=https://sqlpilot.example.com

# --- Observability ---
LOG_LEVEL=info

# --- Frontend (build-time) ---
FRONTEND_API_BASE_URL=http://localhost:3000/api
